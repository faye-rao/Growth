    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^15.0.0",
    "react-querybuilder": "^7.7.0",
    "react-router-dom": "^6.26.0",
    "reactflow": "^11.11.0",
    "zod": "^3.23.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
